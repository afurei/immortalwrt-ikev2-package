#!/bin/sh

umask 077

REQUEST_JSON=""
SWANCTL_BASE=/etc/swanctl
PRIVATE_DIR="$SWANCTL_BASE/private"
CA_CERT_DIR="$SWANCTL_BASE/x509ca"
CERT_DIR="$SWANCTL_BASE/x509"
EXPORT_DIR=/tmp/luci-ipsec-ikev2

json_escape_stream() {
	awk 'BEGIN { ORS="" } { gsub(/\\/, "\\\\"); gsub(/"/, "\\\""); gsub(/\t/, "\\t"); gsub(/\r/, "\\r"); if (NR > 1) printf "\\n"; printf "%s", $0 }'
}

json_get() {
	local key="$1"
	printf '%s' "$REQUEST_JSON" | jsonfilter -q -e "@.$key" 2>/dev/null
}

json_string() {
	printf '%s' "$1" | json_escape_stream
}

bool_cmd() {
	if "$@" >/dev/null 2>&1; then
		printf true
	else
		printf false
	fi
}

json_bool() {
	case "$1" in
	1|true|TRUE|yes|on) printf true ;;
	*) printf false ;;
	esac
}

apply_requested() {
	case "$(json_get apply)" in
	1|true|TRUE|yes|on) return 0 ;;
	*) return 1 ;;
	esac
}

require_uci() {
	if ! command -v uci >/dev/null 2>&1; then
		printf '{ "ok": false, "error": "uci command is not available" }\n'
		exit 1
	fi
}

service_running() {
	ubus call service list '{"name":"swanctl"}' 2>/dev/null | jsonfilter -q -e '@.swanctl.instances.*.running' 2>/dev/null | grep -q true
}

charon_running() {
	pgrep -x charon >/dev/null 2>&1 || pgrep -f '/charon' >/dev/null 2>&1
}

package_installed() {
	local pkg="$1"

	if command -v opkg >/dev/null 2>&1 && opkg status "$pkg" 2>/dev/null | grep -q '^Status: .* installed'; then
		return 0
	fi

	if command -v apk >/dev/null 2>&1 && apk info -e "$pkg" >/dev/null 2>&1; then
		return 0
	fi

	return 1
}

missing_packages_json() {
	local first=1 pkg
	printf '['
	for pkg in jsonfilter ip-full xfrm luci-proto-xfrm kmod-xfrm-interface kmod-ipsec kmod-ipsec4 kmod-ipsec6 kmod-crypto-sha256 kmod-crypto-gcm kmod-crypto-chacha20poly1305 strongswan-swanctl strongswan-charon strongswan-pki strongswan-mod-kernel-netlink strongswan-mod-socket-default strongswan-mod-pubkey strongswan-mod-pem strongswan-mod-pkcs1 strongswan-mod-x509 strongswan-mod-constraints strongswan-mod-openssl strongswan-mod-gcm strongswan-mod-aes strongswan-mod-sha2 strongswan-mod-random strongswan-mod-eap-identity strongswan-mod-eap-mschapv2 strongswan-mod-md4 strongswan-mod-des openssl-util; do
		if ! package_installed "$pkg"; then
			[ "$first" -eq 1 ] || printf ','
			printf '"%s"' "$pkg"
			first=0
		fi
	done
	printf ']'
}

kernel_ipsec_available() {
	command -v ip >/dev/null 2>&1 && ip xfrm state >/dev/null 2>&1
}

kernel_ipsec_message() {
	if kernel_ipsec_available; then
		printf 'kernel XFRM/IPsec netlink is available'
	else
		printf 'kernel XFRM/IPsec netlink is unavailable; load or install matching kmod-ipsec/xfrm_user modules'
	fi
}

count_ike_sas() {
	command -v swanctl >/dev/null 2>&1 || {
		printf 0
		return
	}

	swanctl --list-sas 2>/dev/null | awk '/^[^[:space:]].*: #/ { count++ } END { print count + 0 }'
}

count_child_sas() {
	command -v swanctl >/dev/null 2>&1 || {
		printf 0
		return
	}

	swanctl --list-sas 2>/dev/null | awk '/INSTALLED/ { count++ } END { print count + 0 }'
}

cert_exists_bool() {
	[ -s "$1" ] && printf true || printf false
}

file_exists_bool() {
	[ -f "$1" ] && printf true || printf false
}

validate_safe_name() {
	case "$1" in
	''|*[!A-Za-z0-9._-]*) return 1 ;;
	*) [ "${#1}" -le 64 ] ;;
	esac
}

validate_identifier() {
	case "$1" in
	''|*[!A-Za-z0-9.:-]*) return 1 ;;
	*) [ "${#1}" -le 253 ] ;;
	esac
}

validate_common_name() {
	case "$1" in
	''|*[!A-Za-z0-9._\ -]*) return 1 ;;
	*) [ "${#1}" -le 96 ] ;;
	esac
}

validate_password() {
	case "$1" in
	''|*[!A-Za-z0-9._@%+=:,/-]*) return 1 ;;
	*) [ "${#1}" -le 128 ] ;;
	esac
}

validate_eap_id() {
	case "$1" in
	''|*[!A-Za-z0-9._@+-]*) return 1 ;;
	*) [ "${#1}" -le 128 ] ;;
	esac
}

validate_eap_secret() {
	case "$1" in
	''|*[!A-Za-z0-9._@%+=:,/+-]*) return 1 ;;
	*) [ "${#1}" -le 128 ] ;;
	esac
}

json_error() {
	local message="$1"
	printf '{ "ok": false, "error": "%s" }\n' "$(json_string "$message")"
	exit 1
}

json_ok_message() {
	local message="$1"
	printf '{ "ok": true, "message": "%s" }\n' "$(json_string "$message")"
}

report_begin() {
	report_apply="$1"
	report_first=1
	report_items=
	report_has_conflict=false
}

report_item() {
	local item_name="$1"
	local item_state="$2"
	local item_message="$3"
	local item

	item="$(printf '{"name":"%s","state":"%s","message":"%s"}' "$(json_string "$item_name")" "$(json_string "$item_state")" "$(json_string "$item_message")")"
	if [ "$report_first" -eq 1 ]; then
		report_items="$item"
	else
		report_items="$report_items,$item"
	fi
	[ "$item_state" != conflict ] || report_has_conflict=true
	report_first=0
}

report_end() {
	local changed="$1"
	local reload_required="${2:-$changed}"

	if [ "$report_has_conflict" = true ]; then
		printf '{ "ok": false, "apply": %s, "items": [%s], "changed": %s, "reload_required": %s, "error": "Existing firewall settings conflict with the configured values" }\n' \
			"$report_apply" "$report_items" "$changed" "$reload_required"
	else
		printf '{ "ok": true, "apply": %s, "items": [%s], "changed": %s, "reload_required": %s }\n' \
			"$report_apply" "$report_items" "$changed" "$reload_required"
	fi
}

report_failure() {
	local apply="$1"
	local item_name="$2"
	local message="$3"

	printf '{ "ok": false, "apply": %s, "items": [{"name":"%s","state":"conflict","message":"%s"}], "changed": false, "reload_required": false, "error": "%s" }\n' \
		"$apply" "$(json_string "$item_name")" "$(json_string "$message")" "$(json_string "$message")"
}

section_by_type() {
	local config="$1"
	local type="$2"
	uci -q show "$config" | sed -n "s/^\($config\.[^=]*\)=$type$/\1/p"
}

configured_uplink() {
	local global candidate

	global="$(section_by_type ipsec ipsec | head -n 1)"
	[ -n "$global" ] || return 1
	for candidate in $(uci -q get "$global.interface" 2>/dev/null); do
		case "$candidate" in
		''|loopback|vpn|vpn_vip|*[!A-Za-z0-9_]*) continue ;;
		esac

		if [ "$(uci -q get "network.$candidate" 2>/dev/null)" = interface ] && \
			[ "$(uci -q get "network.$candidate.disabled" 2>/dev/null)" != 1 ]; then
			printf '%s\n' "$candidate"
			return 0
		fi
	done

	return 1
}

configured_vpn_zone() {
	local global zone

	global="$(section_by_type ipsec ipsec | head -n 1)"
	[ -n "$global" ] || return 1
	zone="$(uci -q get "$global.zone" 2>/dev/null)"
	case "$zone" in
	''|*[!A-Za-z0-9_]*) return 1 ;;
	esac

	printf '%s\n' "$zone"
}

zone_for_network() {
	local network="$1"
	local sec networks

	[ -n "$network" ] || return 1
	for sec in $(section_by_type firewall zone); do
		networks="$(uci -q get "$sec.network" 2>/dev/null)"
		case " $networks " in
		*" $network "*)
			uci -q get "$sec.name" 2>/dev/null || return 1
			return 0
			;;
		esac
	done

	return 1
}

section_by_option() {
	local config="$1"
	local type="$2"
	local option="$3"
	local value="$4"
	local sec

	for sec in $(section_by_type "$config" "$type"); do
		[ "$(uci -q get "$sec.$option" 2>/dev/null)" = "$value" ] && {
			printf '%s\n' "$sec"
			return
		}
	done
}

eap_user_section() {
	local id="$1"
	local type sec

	for type in mschapv2_secrets mschapv2_secrets_disabled; do
		for sec in $(section_by_type ipsec "$type"); do
			[ "$(uci -q get "$sec.id" 2>/dev/null)" = "$id" ] && {
				printf '%s\n' "$sec"
				return
			}
		done
	done
}

count_eap_users() {
	command -v uci >/dev/null 2>&1 || {
		printf 0
		return
	}

	local count=0 sec
	for sec in $(section_by_type ipsec mschapv2_secrets); do
		[ -n "$(uci -q get "$sec.id" 2>/dev/null)" ] || continue
		[ -n "$(uci -q get "$sec.secret" 2>/dev/null)" ] || continue
		count=$((count + 1))
	done
	printf '%s' "$count"
}

forwarding_section() {
	local src="$1"
	local dest="$2"
	local sec

	for sec in $(section_by_type firewall forwarding); do
		[ "$(uci -q get "$sec.src" 2>/dev/null)" = "$src" ] && [ "$(uci -q get "$sec.dest" 2>/dev/null)" = "$dest" ] && {
			printf '%s\n' "$sec"
			return
		}
	done
}

ensure_option() {
	local path="$1"
	local option="$2"
	local value="$3"
	local display="$4"
	local apply="$5"
	local cur

	if uci -q get "$path.$option" >/dev/null 2>&1; then
		cur="$(uci -q get "$path.$option" 2>/dev/null)"
		if [ "$cur" = "$value" ]; then
			report_item "$display" ok "$path.$option is $value"
		else
			report_item "$display" conflict "$path.$option is $cur, expected $value"
		fi
	else
		if [ "$apply" = true ]; then
			uci set "$path.$option=$value"
			changed=true
			report_item "$display" added "Set $path.$option to $value"
		else
			report_item "$display" missing "$path.$option is missing"
		fi
	fi
}

ensure_list_value() {
	local path="$1"
	local option="$2"
	local value="$3"
	local display="$4"
	local apply="$5"
	local cur

	cur="$(uci -q get "$path.$option" 2>/dev/null)"

	case " $cur " in
	*" $value "*)
		report_item "$display" ok "$path.$option contains $value"
		;;
	*)
		if [ "$apply" = true ]; then
			uci add_list "$path.$option=$value"
			changed=true
			report_item "$display" added "Added $value to $path.$option"
		else
			report_item "$display" missing "$path.$option does not contain $value"
		fi
		;;
	esac
}

ensure_zone() {
	local apply="$1"
	local zone_name="$2"
	local sec id

	sec="$(section_by_option firewall zone name "$zone_name")"
	if [ -z "$sec" ]; then
		if [ "$apply" = true ]; then
			id="$(uci add firewall zone)"
			sec="firewall.$id"
			uci set "$sec.name=$zone_name"
			changed=true
			report_item "firewall zone $zone_name" added "Created $zone_name zone"
		else
			report_item "firewall zone $zone_name" missing "$zone_name zone is missing"
			return
		fi
	else
		report_item "firewall zone $zone_name" ok "$zone_name zone exists"
	fi

	ensure_option "$sec" input ACCEPT "$zone_name zone input" "$apply"
	ensure_option "$sec" output ACCEPT "$zone_name zone output" "$apply"
	ensure_option "$sec" forward ACCEPT "$zone_name zone forward" "$apply"
	ensure_list_value "$sec" network vpn "$zone_name zone network vpn" "$apply"
	ensure_list_value "$sec" network vpn_vip "$zone_name zone network vpn_vip" "$apply"
}

ensure_forwarding() {
	local apply="$1"
	local src="$2"
	local dest="$3"
	local label="forwarding $src to $dest"
	local sec id

	sec="$(forwarding_section "$src" "$dest")"
	if [ -z "$sec" ]; then
		if [ "$apply" = true ]; then
			id="$(uci add firewall forwarding)"
			sec="firewall.$id"
			uci set "$sec.src=$src"
			uci set "$sec.dest=$dest"
			changed=true
			report_item "$label" added "Created $src to $dest forwarding"
		else
			report_item "$label" missing "$src to $dest forwarding is missing"
		fi
	else
		report_item "$label" ok "$src to $dest forwarding exists"
	fi
}

vpn_masquerade_subnet() {
	local address network prefix

	address="$(uci -q get network.vpn_vip.ipaddr 2>/dev/null)"
	[ -n "$address" ] || return 1
	command -v ipcalc.sh >/dev/null 2>&1 || return 1
	network="$(ipcalc.sh "$address" 2>/dev/null | sed -n 's/^NETWORK=//p')"
	prefix="$(ipcalc.sh "$address" 2>/dev/null | sed -n 's/^PREFIX=//p')"

	case "$network/$prefix" in
	''/*|*/*[!0-9]*|*[!0-9./]*) return 1 ;;
	*) printf '%s/%s' "$network" "$prefix" ;;
	esac
}

ensure_masquerade_source() {
	local apply="$1"
	local zone_name="$2"
	local subnet="$3"
	local sec masq sources

	sec="$(section_by_option firewall zone name "$zone_name")"
	if [ -z "$sec" ]; then
		report_item "vpn egress masquerade" missing "$zone_name zone is missing"
		report_item "vpn egress masquerade source" missing "$subnet masquerade source is missing"
		return
	fi

	masq="$(uci -q get "$sec.masq" 2>/dev/null)"
	sources="$(uci -q get "$sec.masq_src" 2>/dev/null)"
	case "$masq" in
	1)
		report_item "vpn egress masquerade" ok "$sec.masq is 1"
		case " $sources " in
		*" 0.0.0.0/0 "*|*" $subnet "*)
			report_item "vpn egress masquerade source" ok "$sec.masq_src contains ${sources:-0.0.0.0/0}"
			;;
		"  ")
			report_item "vpn egress masquerade source" ok "$sec.masq_src is unrestricted"
			;;
		*)
			ensure_list_value "$sec" masq_src "$subnet" "vpn egress masquerade source" "$apply"
			;;
		esac
		;;
	'')
		if [ "$apply" = true ]; then
			uci set "$sec.masq=1"
			uci add_list "$sec.masq_src=$subnet"
			changed=true
			report_item "vpn egress masquerade" added "Set $sec.masq to 1"
			report_item "vpn egress masquerade source" added "Added $subnet to $sec.masq_src"
		else
			report_item "vpn egress masquerade" missing "$sec.masq is missing"
			report_item "vpn egress masquerade source" missing "$sec.masq_src does not contain $subnet"
		fi
		;;
	*)
		report_item "vpn egress masquerade" conflict "$sec.masq is $masq, expected 1"
		report_item "vpn egress masquerade source" conflict "$sec.masq_src was not changed while masquerading is disabled"
		;;
	esac
}

ensure_rule() {
	local apply="$1"
	local rule_name="$2"
	local src_zone="$3"
	local proto="$4"
	local port="$5"
	local sec id

	sec="$(section_by_option firewall rule name "$rule_name")"
	if [ -z "$sec" ]; then
		if [ "$apply" = true ]; then
			id="$(uci add firewall rule)"
			sec="firewall.$id"
			uci set "$sec.name=$rule_name"
			changed=true
			report_item "$rule_name" added "Created firewall rule $rule_name"
		else
			report_item "$rule_name" missing "$rule_name is missing"
			return
		fi
	else
		report_item "$rule_name" ok "$rule_name exists"
	fi

	ensure_option "$sec" src "$src_zone" "$rule_name src" "$apply"
	ensure_option "$sec" proto "$proto" "$rule_name proto" "$apply"
	[ -n "$port" ] && ensure_option "$sec" dest_port "$port" "$rule_name port" "$apply"
	ensure_option "$sec" target ACCEPT "$rule_name target" "$apply"
}

method_status() {
	printf '{'
	printf '"swanctl_installed":%s,' "$(bool_cmd command -v swanctl)"
	printf '"charon_running":%s,' "$(charon_running && printf true || printf false)"
	printf '"service_running":%s,' "$(service_running && printf true || printf false)"
	printf '"service_enabled":%s,' "$(bool_cmd /etc/init.d/swanctl enabled)"
	printf '"kernel_ipsec_available":%s,' "$(kernel_ipsec_available && printf true || printf false)"
	printf '"kernel_ipsec_message":"%s",' "$(json_string "$(kernel_ipsec_message)")"
	printf '"config_exists":%s,' "$(file_exists_bool /etc/config/ipsec)"
	printf '"ca_cert_exists":%s,' "$(cert_exists_bool "$CA_CERT_DIR/caCert.pem")"
	printf '"server_cert_exists":%s,' "$(cert_exists_bool "$CERT_DIR/serverCert.pem")"
	printf '"server_key_exists":%s,' "$(cert_exists_bool "$PRIVATE_DIR/serverKey.pem")"
	printf '"ike_sas":%s,' "$(count_ike_sas)"
	printf '"child_sas":%s,' "$(count_child_sas)"
	printf '"eap_users":%s,' "$(count_eap_users)"
	printf '"missing_packages":%s' "$(missing_packages_json)"
	printf '}\n'
}

method_service_action() {
	local action out rc escaped

	action="$(json_get action)"

	case "$action" in
	start|stop|restart|reload|enable|disable) ;;
	*) json_error "invalid action" ;;
	esac

	[ -x /etc/init.d/swanctl ] || json_error "swanctl init script not found"

	case "$action" in
	start|restart)
		kernel_ipsec_available || json_error "$(kernel_ipsec_message)"
		;;
	esac

	out="$(/etc/init.d/swanctl "$action" 2>&1)"
	rc="$?"
	escaped="$(printf '%s' "$out" | json_escape_stream)"

	if [ "$rc" -eq 0 ]; then
		printf '{ "ok": true, "action": "%s", "output": "%s" }\n' "$action" "$escaped"
	else
		printf '{ "ok": false, "action": "%s", "rc": %s, "output": "%s" }\n' "$action" "$rc" "$escaped"
		exit "$rc"
	fi
}

method_get_logs() {
	local limit logs

	limit="$(json_get limit)"
	case "$limit" in
	''|*[!0-9]*) limit=80 ;;
	esac
	[ "$limit" -lt 1 ] && limit=1
	[ "$limit" -gt 200 ] && limit=200

	if command -v logread >/dev/null 2>&1; then
		logs="$(logread 2>/dev/null | grep -Ei 'charon|swanctl|ipsec|strongswan' | tail -n "$limit" | json_escape_stream)"
	else
		logs="logread is not available"
	fi

	printf '{ "limit": %s, "logs": "%s" }\n' "$limit" "$logs"
}

append_check() {
	local check_name="$1"
	local ok="$2"
	local message="$3"
	[ -n "$ok" ] || ok=false
	[ "$check_first" -eq 1 ] || printf ','
	printf '{"name":"%s","ok":%s,"message":"%s"}' "$check_name" "$ok" "$(json_string "$message")"
	check_first=0
}

method_validate_config() {
	local check_first responder_enabled credentials_ok child_ifid network_ifid legacy_ok
	local uplink uplink_ok uplink_zone uplink_zone_ok tunlink tunlink_ok
	local vpn_zone network_vpn_zone xfrm_zone_ok pubkey_identity_ok eap_identity_ok

	check_first=1
	responder_enabled=false
	if [ "$(uci -q get ipsec.rw_pubkey.enabled 2>/dev/null)" = "1" ] || [ "$(uci -q get ipsec.rw_eap.enabled 2>/dev/null)" = "1" ]; then
		responder_enabled=true
	fi
	credentials_ok=true
	if [ "$responder_enabled" = true ] && { [ ! -s "$CA_CERT_DIR/caCert.pem" ] || [ ! -s "$CERT_DIR/serverCert.pem" ] || [ ! -s "$PRIVATE_DIR/serverKey.pem" ]; }; then
		credentials_ok=false
	fi
	child_ifid="$(uci -q get ipsec.rw_child.if_id 2>/dev/null)"
	network_ifid="$(uci -q get network.vpn.ifid 2>/dev/null)"
	legacy_ok=true
	if [ -x /etc/init.d/ipsec ] && /etc/init.d/ipsec enabled >/dev/null 2>&1; then
		legacy_ok=false
	fi
	uplink=
	uplink_ok=false
	if uplink="$(configured_uplink)"; then
		uplink_ok=true
	fi
	uplink_zone=
	uplink_zone_ok=false
	if [ "$uplink_ok" = true ] && uplink_zone="$(zone_for_network "$uplink")"; then
		uplink_zone_ok=true
	fi
	tunlink="$(uci -q get network.vpn.tunlink 2>/dev/null)"
	tunlink_ok=false
	if [ "$uplink_ok" = true ] && [ "$tunlink" = "$uplink" ]; then
		tunlink_ok=true
	fi
	vpn_zone="$(configured_vpn_zone)" || vpn_zone=
	network_vpn_zone="$(uci -q get network.vpn.zone 2>/dev/null)"
	xfrm_zone_ok=false
	if [ -n "$vpn_zone" ] && [ "$network_vpn_zone" = "$vpn_zone" ]; then
		xfrm_zone_ok=true
	fi
	pubkey_identity_ok=false
	responder_identity_valid rw_pubkey && pubkey_identity_ok=true
	eap_identity_ok=false
	responder_identity_valid rw_eap && eap_identity_ok=true

	printf '{ "checks": ['
	append_check config_exists "$([ -f /etc/config/ipsec ] && printf true || printf false)" '/etc/config/ipsec exists'
	append_check uci_available "$(command -v uci >/dev/null 2>&1 && printf true || printf false)" 'uci command is available'
	append_check pki_available "$(command -v pki >/dev/null 2>&1 && printf true || printf false)" 'pki command is available'
	append_check kernel_ipsec "$(kernel_ipsec_available && printf true || printf false)" "$(kernel_ipsec_message)"
	append_check xfrm_proto "$([ -x /lib/netifd/proto/xfrm.sh ] && printf true || printf false)" 'netifd xfrm protocol is available'
	append_check remote_rw_pubkey "$(uci -q get ipsec.rw_pubkey >/dev/null 2>&1 && printf true || printf false)" 'remote rw_pubkey section exists'
	append_check remote_rw_eap "$(uci -q get ipsec.rw_eap >/dev/null 2>&1 && printf true || printf false)" 'remote rw_eap section exists'
	append_check ike_proposal "$(uci -q get ipsec.ike_proposal >/dev/null 2>&1 && printf true || printf false)" 'IKE proposal section exists'
	append_check child_tunnel "$(uci -q get ipsec.rw_child >/dev/null 2>&1 && printf true || printf false)" 'child tunnel section exists'
	append_check esp_proposal "$(uci -q get ipsec.esp_proposal >/dev/null 2>&1 && printf true || printf false)" 'ESP proposal section exists'
	append_check address_pool "$(uci -q get ipsec.primaryipv4 >/dev/null 2>&1 && printf true || printf false)" 'address pool section exists'
	append_check eap_user_secrets "$(command -v uci >/dev/null 2>&1 && { [ "$(uci -q get ipsec.rw_eap.enabled 2>/dev/null)" != "1" ] || [ "$(count_eap_users)" -gt 0 ]; } && printf true || printf false)" 'EAP user secret exists when rw_eap is enabled'
	append_check server_credentials "$credentials_ok" 'server credentials exist when a responder is enabled'
	append_check rw_pubkey_certificate_identity "$pubkey_identity_ok" "$([ "$pubkey_identity_ok" = true ] && printf 'rw_pubkey local identifier matches the selected server certificate' || printf 'rw_pubkey local identifier is missing or does not match the selected server certificate')"
	append_check rw_eap_certificate_identity "$eap_identity_ok" "$([ "$eap_identity_ok" = true ] && printf 'rw_eap local identifier matches the selected server certificate' || printf 'rw_eap local identifier is missing or does not match the selected server certificate')"
	append_check uplink_interface "$uplink_ok" "$([ "$uplink_ok" = true ] && printf 'configured uplink interface exists' || printf 'configured uplink interface is missing or invalid')"
	append_check uplink_firewall_zone "$uplink_zone_ok" "$([ "$uplink_zone_ok" = true ] && printf 'firewall zone for configured uplink exists' || printf 'firewall zone for configured uplink is missing')"
	append_check xfrm_tunlink_match "$tunlink_ok" "$([ "$tunlink_ok" = true ] && printf 'network.vpn.tunlink matches configured uplink interface' || printf 'network.vpn.tunlink does not match configured uplink interface')"
	append_check xfrm_zone_match "$xfrm_zone_ok" "$([ "$xfrm_zone_ok" = true ] && printf 'network.vpn.zone matches configured VPN firewall zone' || printf 'network.vpn.zone does not match configured VPN firewall zone')"
	append_check xfrm_ifid_match "$([ -n "$child_ifid" ] && [ "$child_ifid" = "$network_ifid" ] && printf true || printf false)" 'network and CHILD XFRM interface IDs match'
	append_check legacy_ipsec_disabled "$legacy_ok" 'legacy ipsec service is absent or disabled'
	printf '] }\n'
}

method_sync_firewall() {
	local apply include_ah internet uplink inbound_zone vpn_zone vpn_subnet reload_required

	require_uci
	apply=false
	apply_requested && apply=true
	include_ah="$(json_bool "$(json_get include_ah)")"
	internet="$(json_get internet_access)"
	[ -n "$internet" ] || internet=true
	internet="$(json_bool "$internet")"
	if ! uplink="$(configured_uplink)"; then
		report_failure "$apply" "VPN uplink interface" "No configured uplink interface exists"
		return
	fi
	if ! inbound_zone="$(zone_for_network "$uplink")"; then
		report_failure "$apply" "VPN uplink firewall zone" "No firewall zone contains the configured uplink network"
		return
	fi
	if ! vpn_zone="$(configured_vpn_zone)"; then
		report_failure "$apply" "VPN firewall zone" "No VPN firewall zone is configured"
		return
	fi
	if [ "$vpn_zone" = "$inbound_zone" ]; then
		report_failure "$apply" "VPN firewall zone" "VPN and uplink firewall zones must be different"
		return
	fi
	vpn_subnet=
	if [ "$internet" = true ] && ! vpn_subnet="$(vpn_masquerade_subnet)"; then
		report_failure "$apply" "vpn egress masquerade source" "network.vpn_vip.ipaddr is missing or invalid"
		return
	fi
	changed=false
	report_begin "$apply"
	ensure_zone "$apply" "$vpn_zone"
	if [ "$internet" = true ]; then
		ensure_forwarding "$apply" "$vpn_zone" "$inbound_zone"
		ensure_masquerade_source "$apply" "$inbound_zone" "$vpn_subnet"
	fi
	ensure_rule "$apply" Allow-IKEv2-ISAKMP "$inbound_zone" udp 500
	ensure_rule "$apply" Allow-IKEv2-NAT-T "$inbound_zone" udp 4500
	ensure_rule "$apply" Allow-IKEv2-ESP "$inbound_zone" esp ""
	[ "$include_ah" = true ] && ensure_rule "$apply" Allow-IKEv2-AH "$inbound_zone" ah ""
	reload_required=false
	if [ "$apply" = true ] && [ "$changed" = true ]; then
		if ! uci commit firewall; then
			report_item "firewall commit" conflict "Failed to commit firewall configuration"
			reload_required=true
		elif [ ! -x /etc/init.d/firewall ] || ! /etc/init.d/firewall reload >/dev/null 2>&1; then
			report_item "firewall reload" conflict "Failed to reload firewall service"
			reload_required=true
		else
			report_item "firewall reload" ok "Firewall service reloaded"
		fi
	fi
	report_end "$changed" "$reload_required"
}

cert_fingerprint() {
	local file="$1"
	if command -v openssl >/dev/null 2>&1 && [ -s "$file" ]; then
		openssl x509 -in "$file" -noout -fingerprint -sha256 2>/dev/null | sed 's/^.*=//'
	fi
}

cert_subject() {
	local file="$1"
	if command -v openssl >/dev/null 2>&1 && [ -s "$file" ]; then
		openssl x509 -in "$file" -noout -subject 2>/dev/null | sed 's/^subject=//'
	fi
}

cert_identities() {
	local file="$1"
	[ -s "$file" ] || return 0
	command -v openssl >/dev/null 2>&1 || return 0

	{
		openssl x509 -in "$file" -noout -ext subjectAltName 2>/dev/null | \
			sed -n '/Subject Alternative Name/,$p' | sed '1d' | tr ',' '\n' | \
			sed -n \
				-e 's/^[[:space:]]*DNS:[[:space:]]*//p' \
				-e 's/^[[:space:]]*IP Address:[[:space:]]*//p'
		openssl x509 -in "$file" -noout -subject -nameopt RFC2253 2>/dev/null | \
			sed -n -e 's/^subject=//' -e 's/.*CN=\([^,]*\).*/\1/p'
	} | awk 'length($0) <= 253 && $0 ~ /^[A-Za-z0-9.:-]+$/ && !seen[$0]++'
}

cert_preferred_identity() {
	cert_identities "$1" | sed -n '1p'
}

cert_identities_json() {
	local file="$1"
	local identities identity first

	identities="$(cert_identities "$file")"
	first=1
	printf '['
	while IFS= read -r identity; do
		[ -n "$identity" ] || continue
		[ "$first" -eq 1 ] || printf ','
		printf '"%s"' "$(json_string "$identity")"
		first=0
	done <<EOF
$identities
EOF
	printf ']'
}

certificate_has_identity() {
	local file="$1"
	local wanted="$2"

	[ -n "$wanted" ] || return 1
	cert_identities "$file" | awk -v wanted="$wanted" '
		BEGIN { wanted = tolower(wanted) }
		tolower($0) == wanted { found = 1 }
		END { exit(found ? 0 : 1) }
	'
}

responder_identity_valid() {
	local section="$1"
	local cert identity

	cert="$(uci -q get "ipsec.$section.local_cert" 2>/dev/null)"
	identity="$(uci -q get "ipsec.$section.local_identifier" 2>/dev/null)"
	validate_safe_name "$cert" || return 1
	validate_identifier "$identity" || return 1
	[ -s "$CERT_DIR/$cert" ] || return 1
	validate_certificate "$CERT_DIR/$cert" || return 1
	certificate_has_identity "$CERT_DIR/$cert" "$identity"
}

cert_enddate() {
	local file="$1"
	if command -v openssl >/dev/null 2>&1 && [ -s "$file" ]; then
		openssl x509 -in "$file" -noout -enddate 2>/dev/null | sed 's/^notAfter=//'
	fi
}

cert_json() {
	local name="$1"
	local cert="$2"
	local key="$3"
	local preferred

	preferred="$(cert_preferred_identity "$cert")"
	printf '{"name":"%s","cert_exists":%s,"key_exists":%s,"subject":"%s","expires":"%s","fingerprint":"%s","preferred_identifier":"%s","identities":' \
		"$(json_string "$name")" \
		"$(cert_exists_bool "$cert")" \
		"$(cert_exists_bool "$key")" \
		"$(json_string "$(cert_subject "$cert")")" \
		"$(json_string "$(cert_enddate "$cert")")" \
		"$(json_string "$(cert_fingerprint "$cert")")" \
		"$(json_string "$preferred")"
	cert_identities_json "$cert"
	printf '}'
}

server_credential_choices_json() {
	local first cert base stem key preferred

	first=1
	printf '['
	if [ -d "$CERT_DIR" ]; then
		for cert in "$CERT_DIR"/*Cert.pem; do
			[ -f "$cert" ] || continue
			base="${cert##*/}"
			validate_safe_name "$base" || continue
			stem="${base%Cert.pem}"
			key="$PRIVATE_DIR/${stem}Key.pem"
			[ -s "$key" ] || continue
			validate_certificate "$cert" || continue
			key_matches_certificate "$key" "$cert" || continue
			openssl x509 -in "$cert" -noout -purpose 2>/dev/null | grep -q '^SSL server : Yes$' || continue
			preferred="$(cert_preferred_identity "$cert")"
			[ -n "$preferred" ] || continue

			[ "$first" -eq 1 ] || printf ','
			printf '{"name":"%s","cert":"%s","key":"%s","preferred_identifier":"%s","identities":' \
				"$(json_string "$stem")" "$(json_string "$base")" "$(json_string "${stem}Key.pem")" "$(json_string "$preferred")"
			cert_identities_json "$cert"
			printf '}'
			first=0
		done
	fi
	printf ']'
}

ca_certificate_choices_json() {
	local first cert base

	first=1
	printf '['
	if [ -d "$CA_CERT_DIR" ]; then
		for cert in "$CA_CERT_DIR"/*.pem; do
			[ -f "$cert" ] || continue
			base="${cert##*/}"
			validate_safe_name "$base" || continue
			validate_certificate "$cert" || continue

			[ "$first" -eq 1 ] || printf ','
			printf '"%s"' "$(json_string "$base")"
			first=0
		done
	fi
	printf ']'
}

method_list_certs() {
	local first cert base name

	first=1
	printf '{ "ok": true, "ca": '
	cert_json ca "$CA_CERT_DIR/caCert.pem" "$PRIVATE_DIR/caKey.pem"
	printf ', "server": '
	cert_json server "$CERT_DIR/serverCert.pem" "$PRIVATE_DIR/serverKey.pem"
	printf ', "clients": ['
	if [ -d "$CERT_DIR" ]; then
		for cert in "$CERT_DIR"/*Cert.pem; do
			[ -f "$cert" ] || continue
			base="${cert##*/}"
			name="${base%Cert.pem}"
			[ "$name" = server ] && continue
			[ "$first" -eq 1 ] || printf ','
			cert_json "$name" "$cert" "$PRIVATE_DIR/${name}Key.pem"
			first=0
		done
	fi
	printf '], "choices": { "server_credentials": '
	server_credential_choices_json
	printf ', "ca_certificates": '
	ca_certificate_choices_json
	printf '} }\n'
}

method_list_eap_users() {
	local first type sec id enabled

	require_uci
	first=1
	printf '{ "ok": true, "users": ['
	for type in mschapv2_secrets mschapv2_secrets_disabled; do
		for sec in $(section_by_type ipsec "$type"); do
			id="$(uci -q get "$sec.id" 2>/dev/null)"
			[ -n "$id" ] || continue
			[ "$first" -eq 1 ] || printf ','
			if [ "$type" = mschapv2_secrets ]; then
				enabled=true
			else
				enabled=false
			fi
			printf '{"id":"%s","enabled":%s,"has_secret":%s,"section":"%s"}' \
				"$(json_string "$id")" \
				"$enabled" \
				"$([ -n "$(uci -q get "$sec.secret" 2>/dev/null)" ] && printf true || printf false)" \
				"$(json_string "$sec")"
			first=0
		done
	done
	printf '] }\n'
}

method_set_eap_user() {
	local id secret enabled_raw enabled sec type new_id

	require_uci
	id="$(json_get id)"
	secret="$(json_get secret)"
	enabled_raw="$(json_get enabled)"
	[ -n "$enabled_raw" ] || enabled_raw=true
	enabled="$(json_bool "$enabled_raw")"

	validate_eap_id "$id" || json_error "invalid EAP username"
	[ -z "$secret" ] || validate_eap_secret "$secret" || json_error "invalid EAP password"

	sec="$(eap_user_section "$id")"
	[ -n "$sec" ] || [ -n "$secret" ] || json_error "password is required for a new EAP user"

	if [ "$enabled" = true ]; then
		type=mschapv2_secrets
	else
		type=mschapv2_secrets_disabled
	fi

	if [ -z "$sec" ]; then
		new_id="$(uci add ipsec "$type")" || json_error "failed to create EAP user"
		sec="ipsec.$new_id"
		uci set "$sec.id=$id" || json_error "failed to set EAP username"
		uci set "$sec.secret=$secret" || json_error "failed to set EAP password"
	else
		uci set "$sec.id=$id" || json_error "failed to set EAP username"
		[ -z "$secret" ] || uci set "$sec.secret=$secret" || json_error "failed to set EAP password"
		uci set "$sec=$type" || json_error "failed to update EAP user state"
	fi

	uci commit ipsec || json_error "failed to commit EAP user"
	json_ok_message "EAP user saved"
}

method_delete_eap_user() {
	local id sec

	require_uci
	id="$(json_get id)"
	validate_eap_id "$id" || json_error "invalid EAP username"

	sec="$(eap_user_section "$id")"
	if [ -z "$sec" ]; then
		json_ok_message "EAP user not found"
		return
	fi

	uci delete "$sec" || json_error "failed to delete EAP user"
	uci commit ipsec || json_error "failed to commit EAP user deletion"
	json_ok_message "EAP user deleted"
}

cert_dirs() {
	mkdir -p "$PRIVATE_DIR" "$CA_CERT_DIR" "$CERT_DIR" "$EXPORT_DIR" || return 1
	chmod 700 "$PRIVATE_DIR" "$EXPORT_DIR" 2>/dev/null || return 1
	chmod 755 "$CA_CERT_DIR" "$CERT_DIR" 2>/dev/null || return 1
}

require_pki() {
	command -v pki >/dev/null 2>&1 || json_error "pki command is not available"
	command -v openssl >/dev/null 2>&1 || json_error "openssl command is not available"
}

new_temp_file() {
	local label="$1"
	mktemp "$EXPORT_DIR/${label}.XXXXXX"
}

validate_certificate() {
	local cert="$1"
	openssl x509 -in "$cert" -noout >/dev/null 2>&1
}

key_matches_certificate() {
	local key="$1"
	local cert="$2"
	local key_hash cert_hash

	key_hash="$(openssl pkey -in "$key" -pubout 2>/dev/null | sha256sum | awk '{ print $1 }')"
	cert_hash="$(openssl x509 -in "$cert" -pubkey -noout 2>/dev/null | sha256sum | awk '{ print $1 }')"
	[ -n "$key_hash" ] && [ "$key_hash" = "$cert_hash" ]
}

install_generated_pair() {
	local key_tmp="$1"
	local cert_tmp="$2"
	local key_dest="$3"
	local cert_dest="$4"

	chmod 600 "$key_tmp" || return 1
	chmod 644 "$cert_tmp" || return 1
	mv -f "$cert_tmp" "$cert_dest" || return 1
	mv -f "$key_tmp" "$key_dest" || return 1
}

days_value() {
	local days="$1"
	local def="$2"
	case "$days" in
	''|*[!0-9]*) days="$def" ;;
	esac
	[ "$days" -lt 1 ] && days=1
	[ "$days" -gt 3650 ] && days=3650
	printf '%s' "$days"
}

method_generate_ca() {
	local cn days key_tmp cert_tmp err

	require_pki
	cert_dirs || json_error "failed to create certificate directories"
	cn="$(json_get common_name)"
	[ -n "$cn" ] || cn="OpenWrt IKEv2 CA"
	validate_common_name "$cn" || json_error "invalid CA common name"
	days="$(days_value "$(json_get days)" 3650)"

	key_tmp="$(new_temp_file ca-key)" || json_error "failed to create temporary CA key"
	cert_tmp="$(new_temp_file ca-cert)" || {
		rm -f "$key_tmp"
		json_error "failed to create temporary CA certificate"
	}
	err="$EXPORT_DIR/ca.err"
	rm -f "$err"

	if ! pki --gen --type rsa --size 4096 --outform pem >"$key_tmp" 2>"$err"; then
		rm -f "$key_tmp" "$cert_tmp"
		json_error "failed to generate CA private key"
	fi
	if ! pki --self --ca --lifetime "$days" --in "$key_tmp" --type rsa --dn "CN=$cn" --outform pem >"$cert_tmp" 2>"$err"; then
		rm -f "$key_tmp" "$cert_tmp"
		json_error "failed to generate CA certificate"
	fi
	if ! validate_certificate "$cert_tmp" || ! key_matches_certificate "$key_tmp" "$cert_tmp"; then
		rm -f "$key_tmp" "$cert_tmp"
		json_error "generated CA certificate validation failed"
	fi
	install_generated_pair "$key_tmp" "$cert_tmp" "$PRIVATE_DIR/caKey.pem" "$CA_CERT_DIR/caCert.pem" || {
		rm -f "$key_tmp" "$cert_tmp"
		json_error "failed to install generated CA material"
	}
	rm -f "$err"
	json_ok_message "CA certificate generated"
}

method_generate_server_cert() {
	local id days key_tmp cert_tmp err

	require_pki
	cert_dirs || json_error "failed to create certificate directories"
	id="$(json_get identifier)"
	if [ -z "$id" ] && command -v uci >/dev/null 2>&1; then
		id="$(uci -q get ipsec.rw_pubkey.local_identifier 2>/dev/null)"
		[ -n "$id" ] || id="$(uci -q get ipsec.rw_eap.local_identifier 2>/dev/null)"
	fi
	[ -n "$id" ] || id="vpn.example.net"
	validate_identifier "$id" || json_error "invalid server identifier"
	days="$(days_value "$(json_get days)" 1825)"
	[ -s "$CA_CERT_DIR/caCert.pem" ] || json_error "CA certificate is missing"
	[ -s "$PRIVATE_DIR/caKey.pem" ] || json_error "CA private key is missing"

	key_tmp="$(new_temp_file server-key)" || json_error "failed to create temporary server key"
	cert_tmp="$(new_temp_file server-cert)" || {
		rm -f "$key_tmp"
		json_error "failed to create temporary server certificate"
	}
	err="$EXPORT_DIR/server.err"
	rm -f "$err"

	if ! pki --gen --type rsa --size 3072 --outform pem >"$key_tmp" 2>"$err"; then
		rm -f "$key_tmp" "$cert_tmp"
		json_error "failed to generate server private key"
	fi
	if ! pki --pub --in "$key_tmp" --type rsa 2>"$err" | \
		pki --issue --lifetime "$days" --cacert "$CA_CERT_DIR/caCert.pem" --cakey "$PRIVATE_DIR/caKey.pem" --dn "CN=$id" --san "$id" --flag serverAuth --flag ikeIntermediate --outform pem >"$cert_tmp" 2>>"$err"; then
		rm -f "$key_tmp" "$cert_tmp"
		json_error "failed to generate server certificate"
	fi
	if ! validate_certificate "$cert_tmp" || ! key_matches_certificate "$key_tmp" "$cert_tmp" || \
		! openssl verify -CAfile "$CA_CERT_DIR/caCert.pem" "$cert_tmp" >/dev/null 2>&1; then
		rm -f "$key_tmp" "$cert_tmp"
		json_error "generated server certificate validation failed"
	fi
	install_generated_pair "$key_tmp" "$cert_tmp" "$PRIVATE_DIR/serverKey.pem" "$CERT_DIR/serverCert.pem" || {
		rm -f "$key_tmp" "$cert_tmp"
		json_error "failed to install generated server material"
	}
	rm -f "$err"
	json_ok_message "Server certificate generated"
}

method_generate_client_cert() {
	local name days key_tmp cert_tmp err

	require_pki
	cert_dirs || json_error "failed to create certificate directories"
	name="$(json_get name)"
	validate_safe_name "$name" || json_error "invalid client name"
	days="$(days_value "$(json_get days)" 825)"
	[ -s "$CA_CERT_DIR/caCert.pem" ] || json_error "CA certificate is missing"
	[ -s "$PRIVATE_DIR/caKey.pem" ] || json_error "CA private key is missing"

	key_tmp="$(new_temp_file client-key)" || json_error "failed to create temporary client key"
	cert_tmp="$(new_temp_file client-cert)" || {
		rm -f "$key_tmp"
		json_error "failed to create temporary client certificate"
	}
	err="$EXPORT_DIR/client.err"
	rm -f "$err"

	if ! pki --gen --type rsa --size 3072 --outform pem >"$key_tmp" 2>"$err"; then
		rm -f "$key_tmp" "$cert_tmp"
		json_error "failed to generate client private key"
	fi
	if ! pki --pub --in "$key_tmp" --type rsa 2>"$err" | \
		pki --issue --lifetime "$days" --cacert "$CA_CERT_DIR/caCert.pem" --cakey "$PRIVATE_DIR/caKey.pem" --dn "CN=$name" --san "$name" --flag clientAuth --outform pem >"$cert_tmp" 2>>"$err"; then
		rm -f "$key_tmp" "$cert_tmp"
		json_error "failed to generate client certificate"
	fi
	if ! validate_certificate "$cert_tmp" || ! key_matches_certificate "$key_tmp" "$cert_tmp" || \
		! openssl verify -CAfile "$CA_CERT_DIR/caCert.pem" "$cert_tmp" >/dev/null 2>&1; then
		rm -f "$key_tmp" "$cert_tmp"
		json_error "generated client certificate validation failed"
	fi
	install_generated_pair "$key_tmp" "$cert_tmp" "$PRIVATE_DIR/${name}Key.pem" "$CERT_DIR/${name}Cert.pem" || {
		rm -f "$key_tmp" "$cert_tmp"
		json_error "failed to install generated client material"
	}
	rm -f "$err"
	json_ok_message "Client certificate generated"
}

method_export_client_p12() {
	local name password key cert ca out size tmp

	require_pki
	cert_dirs || json_error "failed to create export directory"
	name="$(json_get name)"
	password="$(json_get password)"
	validate_safe_name "$name" || json_error "invalid client name"
	validate_password "$password" || json_error "invalid export password"
	key="$PRIVATE_DIR/${name}Key.pem"
	cert="$CERT_DIR/${name}Cert.pem"
	ca="$CA_CERT_DIR/caCert.pem"
	out="$EXPORT_DIR/${name}.p12"
	[ -s "$key" ] || json_error "client private key is missing"
	[ -s "$cert" ] || json_error "client certificate is missing"
	[ -s "$ca" ] || json_error "CA certificate is missing"

	tmp="$(new_temp_file p12)" || json_error "failed to create temporary p12 bundle"
	if ! LUCIP12_PASSWORD="$password" openssl pkcs12 -export -inkey "$key" -in "$cert" -certfile "$ca" -name "$name" -out "$tmp" -passout env:LUCIP12_PASSWORD >"$EXPORT_DIR/p12.out" 2>"$EXPORT_DIR/p12.err"; then
		rm -f "$tmp"
		json_error "failed to export p12 bundle"
	fi
	chmod 600 "$tmp" || {
		rm -f "$tmp"
		json_error "failed to protect p12 bundle"
	}
	mv -f "$tmp" "$out" || {
		rm -f "$tmp"
		json_error "failed to install p12 bundle"
	}
	size="$(wc -c < "$out" 2>/dev/null | tr -d ' ')"
	printf '{ "ok": true, "message": "Client p12 exported", "path": "%s", "size": %s }\n' "$(json_string "$out")" "${size:-0}"
}

case "$1" in
list)
	cat <<'JSON'
{
  "status": {},
  "service_action": { "action": "string" },
  "get_logs": { "limit": "number" },
	  "validate_config": {},
	  "sync_firewall": { "apply": "boolean", "internet_access": "boolean", "include_ah": "boolean" },
	  "list_certs": {},
  "list_eap_users": {},
  "set_eap_user": { "id": "string", "secret": "string", "enabled": "boolean" },
  "delete_eap_user": { "id": "string" },
  "generate_ca": { "common_name": "string", "days": "number" },
  "generate_server_cert": { "identifier": "string", "days": "number" },
  "generate_client_cert": { "name": "string", "days": "number" },
  "export_client_p12": { "name": "string", "password": "string" }
}
JSON
	;;
call)
	method="$2"
	REQUEST_JSON="$(cat)"
	case "$method" in
	status) method_status ;;
	service_action) method_service_action ;;
	get_logs) method_get_logs ;;
		validate_config) method_validate_config ;;
		sync_firewall) method_sync_firewall ;;
		list_certs) method_list_certs ;;
	list_eap_users) method_list_eap_users ;;
	set_eap_user) method_set_eap_user ;;
	delete_eap_user) method_delete_eap_user ;;
	generate_ca) method_generate_ca ;;
	generate_server_cert) method_generate_server_cert ;;
	generate_client_cert) method_generate_client_cert ;;
	export_client_p12) method_export_client_p12 ;;
	*) json_error "unknown method" ;;
	esac
	;;
*)
	json_error "unsupported rpcd operation"
	;;
esac

exit 0
